{
  "metadata": {
    "name": "MSP-1 Architect Examples",
    "version": "1.0.1",
    "lastUpdated": "2026-07-01",
    "purpose": "Examples for the MSP-1 Schema Architect v1.0.1: clean page, clean site, homepage both mode, repair, legacy compliance warning, and explicit multi-input batch behavior.",
    "notes": [
      "Examples are illustrative and do not replace msp-1-page.json or msp-1-site.json validation.",
      "New v1.0.1 outputs do not emit compliance.",
      "Final structural validation should be performed by the MSP-1 Validator."
    ]
  },
  "examples": {
