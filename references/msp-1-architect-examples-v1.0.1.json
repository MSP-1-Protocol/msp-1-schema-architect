              },
              {
                "field": "compliance",
                "severity": "advisory",
                "message": "Deprecated compatibility field encountered; removed from repaired v1.0.1 output."
              }
            ],
            "repairsApplied": [
              "Updated protocol.version to 1.0.1.",
              "Removed deprecated compliance field.",
              "Normalized description and intent to lean string forms.",
              "Updated revision metadata to record repair."
            ],
            "humanReviewRecommended": true
          }
        ]
      },
      "repairedOutputObject": {
        "@context": "https://msp-1.org/schema/msp-1-site.json",
        "@type": "MSPSite",
        "protocol": {
          "name": "MSP-1",
          "version": "1.0.1"
        },
        "discovery": {
          "wellKnown": "/.well-known/msp.json",
          "canonical": true
        },
        "site": {
          "id": "example-site",
          "name": "Example Website",
          "url": "https://example.com/",
          "description": "An example website.",
          "intent": "Provide informational content."
        },
        "trust": {
          "level": "medium",
          "verificationLevel": "self-declared"
        },
        "revision": {
          "id": "site-rev-2026-07-01",
          "revisionDate": "2026-07-01",
          "revisionNotes": "Repaired legacy MSP-1 declaration for v1.0.1; removed deprecated compliance field and updated protocol version; human review recommended.",
          "revisionVersion": "1.0.1"
        },
        "provenance": {
          "type": "ai-assisted",
          "timestamp": "2026-07-01T00:00:00Z",
          "notes": "MSP-1 repair performed from user-provided legacy declaration."
        }
      },
      "transport": "Emit reviewReport first as json, then repairedOutputObject as raw json."
    },
